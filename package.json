{
  "name": "painel-da-casa",
  "version": "0.1.0",
  "private": true,
  "description": "Hábitos, mercado, pendências e registro do dia num painel sempre aberto no iPad da casa.",
  "type": "module",
  "scripts": {
    "start": "node servidor/servidor.js",
    "portoes": "portao-contexto",
    "unit": "node --test \"test/unit/*.test.js\"",
    "integracao": "node --test \"test/integracao/*.test.js\"",
    "test": "portao-contexto && node --test \"test/unit/*.test.js\" \"test/integracao/*.test.js\"",
    "senha-backup": "node servidor/senha-backup.js",
    "restaurar": "node servidor/restaurar.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@varias-ideias/plataforma": "github:Varias-Ideias/plataforma"
  }
}
